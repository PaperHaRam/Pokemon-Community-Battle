{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "challenges": {
      "$targetUid": {
        "$sourceUid": {
          ".read": "auth != null && (auth.uid === $targetUid || auth.uid === $sourceUid)",
          ".write": "auth != null && (auth.uid === $targetUid || auth.uid === $sourceUid)"
        },
        ".read": "auth != null && auth.uid === $targetUid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('participants').child(auth.uid).exists()",
        "state": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid"
        },
        "status": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid"
        },
        "resolvedTurn": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid"
        },
        "actions": {
          "$turn": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('participants').child($uid).exists()"
            }
          }
        },
        "switches": {
          "$turn": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('participants').child($uid).exists()"
            }
          }
        }
      }
    }
  }
}